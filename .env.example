# Suari Ka Alarm - Environment Variables
# Copy this file to .env and fill in your values

# Experiential Labs API Key
# Get it from: https://platform.experientiallabs.ai
EXPO_PUBLIC_EXPLABS_API_KEY=your_api_key_here

# Supabase Configuration (Optional - for cloud sync)
# Get it from: https://app.supabase.com
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
